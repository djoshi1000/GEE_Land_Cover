// 3) Function to convert one filtered class into text

function makeImportText(info, classIndex, totalClasses, list) {

  // If GEE gives undefined, treat it safely as empty.
  list = list || [];

  var lines = [];

  if (classIndex === 0) {
    lines.push("var " + info.name + " = /* color: " + info.color + " */ee.FeatureCollection(");
  } else {
    lines.push("    " + info.name + " = /* color: " + info.color + " */ee.FeatureCollection(");
  }

  lines.push("        [");

  list.forEach(function(feature, i) {
    var coords = feature.geometry.coordinates;
    var props = feature.properties || {};
    var comma = i < list.length - 1 ? "," : "";

    lines.push("        ee.Feature(");
    lines.push("            ee.Geometry.Point([" + coords[0] + ", " + coords[1] + "]),");
    lines.push("            {");
    lines.push('              "Class": ' + JSON.stringify(props.Class) + ",");
    lines.push('              "system:index": ' + JSON.stringify(String(i)));
    lines.push("            })" + comma);
  });

  if (classIndex < totalClasses - 1) {
    lines.push("        ]),");
  } else {
    lines.push("        ]);");
  }

  return lines.join("\n");
}


// 4) Filter and print all classes

var outputParts = [];
var finished = 0;

classInfo.forEach(function(info, classIndex) {

  var filtered = info.collection.filterBounds(fortBend.geometry());

  Map.addLayer(filtered, {color: info.color}, info.name);

  print(info.name + " count inside Fort Bend:", filtered.size());

  filtered.size().evaluate(function(count) {

    // If class has 0 points inside Fort Bend, still print empty collection.
    if (count === 0) {
      outputParts[classIndex] = makeImportText(
        info,
        classIndex,
        classInfo.length,
        []
      );

      finished++;

      if (finished === classInfo.length) {
        print("COPY THIS FULL FILTERED IMPORT BLOCK:", outputParts.join("\n"));
      }

    } else {

      filtered.toList(count).evaluate(function(list) {

        outputParts[classIndex] = makeImportText(
          info,
          classIndex,
          classInfo.length,
          list
        );

        finished++;

        if (finished === classInfo.length) {
          print("COPY THIS FULL FILTERED IMPORT BLOCK:", outputParts.join("\n"));
        }

      });

    }

  });

});
