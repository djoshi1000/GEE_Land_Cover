 // Function to Create a HGAC Geometry
 function generate_HGAC_counties() {
  var counties = ee.FeatureCollection(TIGER_COUNTIES_ASSET);
  
  var texasFilter = ee.Filter.eq('STATEFP', STATE_FIPS);

  var countyFipsFilter = ee.Filter.inList('COUNTYFP', 
      [AUSTIN_COUNTY_FIPS, BRAZORIA_COUNTY_FIPS, CHAMBERS_COUNTY_FIPS,  COLORADO_COUNTY_FIPS,
      FORT_BEND_COUNTY_FIPS, GALVESTON_COUNTY_FIPS, HARRIS_COUNTY_FIPS, LIBERTY_COUNTY_FIPS,
      MATAGORDA_COUNTY_FIPS, MONTGOMERY_COUNTY_FIPS, WHARTON_COUNTY_FIPS, WALKER_COUNTY_FIPS, WALLER_COUNTY_FIPS ]
  );

  var combinedFilter = ee.Filter.and(texasFilter, countyFipsFilter);

  var selectedCounties = counties.filter(combinedFilter);

  var HGAC_Geometry = selectedCounties.geometry().dissolve({maxError: 1});
  
  return {
    geometry: HGAC_Geometry,
    features: selectedCounties
  };
}

