function safeAssetName(txt) {
  return String(txt).replace(/[^A-Za-z0-9_]+/g, '_');
}

function buildModelAssetId() {
  return 'projects/' + GEE_PROJECT_ID + '/assets/rf_models/' +
         safeAssetName(project_name) + '_' +
         String(targetYear) + '_' +
         safeAssetName(MOSAIC_MODE_PRIMARY) + '_' +
         MODEL_VERSION;
}



// ==================================================================================
//                     EXPORT TRAINED CLASSIFIER + METADATA
