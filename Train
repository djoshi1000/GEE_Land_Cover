// 4) GLCM TEXTURE + DERIVED BANDS (ALL-IN-ONE)
// =======================================================================
  function addGLCM(image, texture_type, band) {
      var kernel_size = 3;
      
      var src = image.select(band)
        .unmask(0) 
        .multiply(255) 
        .toInt16();
  
      var glcm = src.glcmTexture({
          size: kernel_size,
      });
  
      // 3. SAFE BAND SELECTION AND RENAMING
      var expected = band + '_' + texture_type;
      var finalBandName = band + '_GLCM_' + texture_type;
  
      var safe = ee.Algorithms.If(
        glcm.bandNames().contains(expected),
        glcm.select(expected).rename(finalBandName),
        ee.Image(0).rename(finalBandName)
      );
  
      return image.addBands(safe);
  }

function addAllDerivedBands(image) {
  image = scaleSentinel2(image);
  
  // (Your existing spectral variables: blue, green, red, nir, etc...)
  var blue  = image.select('B2');
  var green = image.select('B3');
  var red   = image.select('B4');
  var nir   = image.select('B8');
  var nir8a = image.select('B8A');
  var swir1 = image.select('B11');
  var swir2 = image.select('B12');
  
  // (Your existing indices math: mndwi, bsi, evi2, etc...)
  var ndvi = image.normalizedDifference(['B4', 'B8']).rename('NDVI');
  var ndwi = image.normalizedDifference(['B3', 'B8']).rename('NDWI');
  var mndwi = image.normalizedDifference(['B3','B11']).rename('B_MNDWI');
  var ndmi  = image.normalizedDifference(['B8A','B11']).rename('B_NDMI');
  //var ndbi  = image.normalizedDifference(['B11','B8']).rename('B_NDBI');  
  var evi2  = image.expression('2.5*(NIR-RED)/(NIR+2.4*RED+1.0)', {NIR: nir, RED: red}).rename('B_EVI2');
  var ndre  = image.normalizedDifference(['B8A','B5']).rename('B_NDRE');
  var lswi  = image.expression('(B8 - B11) / (B8 + B11)', {'B8': nir, 'B11': swir1}).rename('B_LSWI');
  var nbr    = image.normalizedDifference(['B8','B12']).rename('B_NBR');
  
  // SWIR Combinations
  var swir_r = image.expression('(B11) / (B12)', {'B11': swir1, 'B12': swir2}).rename('B_SWIR_Ratio'); 
  var clay   = image.expression('(B8 + B11) / B12', {'B8': nir, 'B11': swir1, 'B12': swir2}).rename('B_ClayMineralIndex');
  var swir = clay.add(swir_r).divide(2).rename('B_SWIR_COMBO');
  var waterMask = ndwi.gt(0.1);
  
  // === BAEI =====================================================
  var baeiRaw = image.expression('(B4 + 0.3) / (B3 + B11)', {
    'B4': image.select('B4'), 
    'B3': image.select('B3'), 
    'B11': image.select('B11')
  }).rename('B_BAEI');
  
  var baei = baeiRaw.where(ndwi.gt(0), 0).rename('B_BAEI');
  
  baei = baei.where(baei.gt(2), 2);
  
  // === Tasseled Cap Wetness (TCW) =====================================
  var tcw = image.expression(
    '(0.1509 * B2) + (0.1973 * B3) + (0.3283 * B4) + (0.3407 * B8) - (0.7117 * B11) - (0.4559 * B12)', {
      'B2': blue,
      'B3': green,
      'B4': red,
      'B8': nir,
      'B11': swir1,
      'B12': swir2
  }).rename('B_TCW');


  // === Moisture =====================================================
  var glcm_var = addGLCM(ndmi, 'var', 'B_NDMI').select('B_NDMI_GLCM_var');
  var glcm_rescaled = glcm_var.unitScale(0, 0.1); // Adjust 0.1 based on your new stats
  
  var moisture = ndmi.add(glcm_rescaled).divide(2).rename('B_MOISTURE');
  moisture = moisture.where(ndwi.gt(0), -1);
  
  
  // === BSDI =====================================================
  var dryness = image.expression(
    '((B11 + B4) - (B8 + B2)) / ((B11 + B4) + (B8 + B2))', {
      'B11': image.select('B11'),
      'B4': image.select('B4'),
      'B8': image.select('B8'),
      'B2': image.select('B2')
  }).rename('B_DRYNESS');
  
  var comboVeg = image.expression('(EVI * (LSWI + NBR)) / 2', {
    'EVI': evi2,
    'LSWI': lswi,
    'NBR': nbr
  }).rename('B_COMBO_VEG');
  
  var pastureIndex = comboVeg.subtract(dryness).rename('B_PASTURE_PROB');
  
  var finalPastureBand = pastureIndex
    .where(waterMask, -5)
    .rename('B_PASTURE_PROB');
  
  finalPastureBand = finalPastureBand.unmask(-5);
  


  // === Elevation =====================================================
  var elevation = ee.Image("USGS/NED"); 
  var studyArea = image.geometry();
  var targetProjection = image.select('B2').projection();
  
  var slopeRad = ee.Terrain.slope(elevation)
    .multiply(Math.PI / 180)
    .rename('B_SLOPE')
    .clip(studyArea);
    
  slopeRad = slopeRad.focal_mean(30, 'circle', 'meters').rename('B_SLOPE');
  
  var flowAcc90m = ee.Image('WWF/HydroSHEDS/15ACC').select('b1').clip(studyArea);
  
  var flowAcc10m = flowAcc90m
    .resample('bilinear') 
    .reproject({
      crs: targetProjection,
      scale: 10
    });
  
  var TWI = flowAcc10m
    .divide(slopeRad.add(0.001))
    .add(1)
    .log()
    .rename('B_TWI');
  
  TWI = TWI.focal_mean(60, 'circle', 'meters').unmask(0);
  
  slopeRad = slopeRad.unmask(0);
  TWI = TWI.unmask(0);
  
  TWI = TWI
    .resample('bilinear')
    .unmask(0)
    .reproject({crs: targetProjection, scale: 10});
  
  slopeRad = slopeRad
    .unmask(0)
    .reproject({crs: targetProjection, scale: 10});
    
    
  
  // === Sentinel-1  =====================================================
  var s1 = ee.ImageCollection('COPERNICUS/S1_GRD')
    .filterBounds(image.geometry())
    .filterDate(image.date().advance(-1, 'month'), image.date().advance(1, 'month'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
    .filter(ee.Filter.eq('instrumentMode', 'IW'))
    .select(['VV', 'VH']);
  
  var emptyImage = ee.Image([0, 0, 0, 0])
    .rename(['B_VV_VH_Ratio', 'B_RVI', 'B_VV_StdDev', 'B_VH_StdDev'])
    .unmask(0); 
  
  var s1Stack = ee.Image(ee.Algorithms.If(
    s1.size().gt(0),
    (function() {
      var s1Mean = s1.mean();
      
      // 1. Log-RVI Math (Surgical Fix: Renamed to match return)
      var vhPower = s1Mean.select('VH').divide(10).pow(10);
      var vvPower = s1Mean.select('VV').divide(10).pow(10);
      var denominator = vvPower.add(vhPower).add(0.0001);
      var rviLinear = vhPower.multiply(4).divide(denominator);
      
      // Convert to log scale and clean
      var rvi = rviLinear.add(1).log10().rename('B_RVI');
      rvi = rvi.where(rvi.gt(2), 2).unmask(0);
      
      // 2. StdDev Math
      var std = s1.reduce(ee.Reducer.stdDev())
        .rename(['B_VV_StdDev', 'B_VH_StdDev'])
        .unmask(0);
  
      return rvi.addBands(std);
    })(),

    emptyImage.select(['B_RVI', 'B_VV_StdDev', 'B_VH_StdDev'])
  )).clip(image.geometry());
  
  s1Stack = s1Stack.setDefaultProjection(targetProjection, null, 10);
  var finalImage = image.addBands(s1Stack);


  // Final Assembly with Band Names
  var final_stack = image.addBands([
    ndvi,
    mndwi,            // B_MNDWI
    ndre,             // B_NDRE
    baei,             // B_BAEI
    moisture,         // B_MOISTURE
    swir,             // B_SWIR_COMBO
    nir,              // B8
    blue,             // B2
    TWI,              // B_TWI
    s1Stack,          // B_RVI, B_VV_StdDev, B_VH_StdDev
    comboVeg,         // B_COMBO_VEG
    slopeRad.unmask(0), // B_SLOPE
    finalPastureBand,  // B_PASTURE_PROB
    tcw               // B_TCW
  ]);

  // 1. Run GLCM on the full-precision stack
  final_stack = addGLCM(final_stack, 'var', 'B8');
  
  // 2. Surgical Fix: Round the entire stack to 5 decimal places at the very end
  var rounded_stack = final_stack.multiply(100000).round().divide(100000);
  return rounded_stack.select(processing_bands);

  
  // 3. Select your bands from the rounded result
  return rounded_stack.select(processing_bands);
}




