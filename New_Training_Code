// Legend (left)
function makeLegend(palette, labels, title) {
  var legend = ui.Panel({style: {padding: '8px 12px', backgroundColor: 'white'}});
  legend.add(ui.Label({value: title, style: {fontWeight: 'bold', fontSize: '14px', margin: '0 0 6px 0'}}));
  labels.forEach(function (name, i) {
    legend.add(ui.Panel({
      widgets: [ui.Label('', {backgroundColor: palette[i], padding: '8px', margin: '0 6px 0 0', border: '1px solid #000'}),
                ui.Label(name, {fontSize: '12px', margin: '0'})],
      layout: ui.Panel.Layout.flow('horizontal')
    }));
  });
  return legend;
}
Map.add(ui.Panel({
  widgets: [ui.Label(' Random Forest Application', {fontWeight: 'bold', fontSize: '24px'}),
