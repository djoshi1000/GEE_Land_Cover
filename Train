function normalizeGeom(g) {
  var asFC = ee.FeatureCollection(g);
  var isFC = asFC.size().gt(0);

  return ee.Algorithms.If(
    isFC,
    asFC.union().geometry(),

    ee.Algorithms.If(
      ee.Algorithms.ObjectType(g).compareTo('Feature').eq(0),
      ee.Feature(g).geometry(),
      ee.Geometry(g)
    )
  );
}

function hasMinPoints(geomObj, minPoints) {
  var geom = ee.Geometry(normalizeGeom(geomObj));

  var coords = geom.coordinates().flatten();
  var numPoints = coords.length();

  return numPoints.gte(minPoints);  // returns ee.Boolean
}

function allGeomsHaveMinPoints(geomList, minPoints) {
  geomList = ee.List(geomList);

  var checks = geomList.map(function(g) {
    return hasMinPoints(g, minPoints);  // ee.Boolean
  });

  return ee.List(checks).reduce(ee.Reducer.min());  // ee.Number (0 or 1)
}

