// ==================================================================================
//                              MACHINE LEARNING
// ==================================================================================
function run_ml_model(processing_bands) {
      
      // ==== Summer RGB mosaic (separate from ML stack) =========================
    function buildS2_RGB(dateRange, aoi, cloudPct) {
      var rgbCol = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
        .filterDate(dateRange)
        .filterBounds(aoi)
        .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', cloudPct))
        .map(maskS2clouds)
        .map(scaleSentinel2)
        .select(['B4', 'B3', 'B2']);   // TRUE RGB
    
      rgbCol = resampleCollectionTo10m(rgbCol);
    
      return rgbCol.median().clip(aoi);
    }

  

    processing_bands = FINAL_MODEL_BANDS.slice();
  // ==================================================================================
  //                              External Assets 
  // ==================================================================================
  if (USE_MERGED_ASSET) {
    print("Trying External Samples...");
    
    //var mod = require('users/jmarcelc/Repo:HGAC_WesternSamples_Campos'); 
  
    try {
      // Attempt to load the module and assign it to the pre-declared 'mod' variable
      print('Module loaded:', external_samples_path);
      // print(mod); // Optional: Use this to inspect the content of the loaded module
    } catch (err) {
      // This runs if the path is invalid, permissions are denied, or the module crashes
      print('Require() failed:', err);
    }
  
    // Check if the module load attempt was successful
    if (!mod) {
      print('Module is undefined — stopping override. Using default top imports.');
    } else {
      // --- Module loaded successfully, proceed to check contents and override ---
  
      function check(name) {
        // Check if the required field exists in the loaded module
        var ok = mod[name] !== undefined;
        print('Field:', name + (ok ? ' - PRESENT' : ' - MISSING!'));
        return ok;
      }
  
      // List of required variables (must match the module's exports)
      var required = [
        'B2',
        'B3',
        'B4',
        'B8',
        'B11',
        'B12',
        'B_NDRE',
        'B_NDVI',
        'B_MNDWI',
        'B_BAEI',
        'B_COMBO_VEG',
        'B_SLOPE',
        'B8_GLCM_var',
        'B_MOISTURE',
        'B_SWIR_COMBO',
        'B_TWI',
        'B_VH_StdDev',
        'B_VV_StdDev',
        'B_RVI',
        'B_PASTURE_PROB',
        'B_TCW'
      ];
  
      var allOK = true;
      required.forEach(function(name) {
        if (!check(name)) allOK = false;
      });
  
      if (!allOK) {
        print('Some required fields missing — NOT overriding imports. Using default top imports.');
      } else {
        print('All fields present — OVERRIDING imports.');
  
        // CRITICAL FIX: No 'var' used here. Reassigns the global variables 
        // created by the top GEE import section.
        Water_11             = mod.Water_11;
        Develop_NoStructure_20 = mod.Develop_20; // This assumes mod.Develop_20 is correctly named Develop_NoStructure_20 in the top imports
        Develop_Open_21      = mod.Develop_21;
        Develop_Low_22       = mod.Develop_22;
        Develop_Medium_23    = mod.Develop_23;
        Develop_High_24      = mod.Develop_24;
        Barren_Land_31       = mod.Barren_Land_31;
        Deciduous_Forest_41  = mod.Deciduous_Forest_41;
        Evergreen_Forest_42  = mod.Evergreen_Forest_42;
        Mixed_Forest_43      = mod.Mixed_Forest_43;
        Shrub_52             = mod.Shrub_52;
        Grassland_71         = mod.Grassland_71;
        Pasture_81           = mod.Pasture_81;
