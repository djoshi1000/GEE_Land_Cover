var EPS = 1e-4;
var VIS_RGB = { bands: ['B4', 'B3', 'B2'], min: 0.02, max: 0.30 };

function safeAssetName(txt) { return String(txt).replace(/[^A-Za-z0-9_]+/g, '_'); }
