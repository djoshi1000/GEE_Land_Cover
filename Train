// Importance: 
// Resort Function 
function sortImportanceDictionary(impDict) {

  impDict.evaluate(function(impObj) {
    if (!impObj) {
      print("Error: Importance dictionary is null. Cannot sort bands.");
      return;
    }

    var entries = [];
    for (var key in impObj) {
      if (impObj.hasOwnProperty(key)) {
        entries.push([key, impObj[key]]);
      }
    }
    // Sort Entries
    entries.sort(function(a, b) {
      return b[1] - a[1];
    });

    var sortedFinalDict = {};
    var sortedOutputList = [];
    
    for (var i = 0; i < entries.length; i++) {
        var key = entries[i][0];
        var value = entries[i][1];
        var formattedValue = value.toFixed(4); 

        sortedFinalDict[key] = value;
        
        var formattedEntry = (i + 1) + ". " + key + ": " + formattedValue;
        sortedOutputList.push(formattedEntry);
    }
    
    // --- Print Results ---
    print("Sorted Features List (Rank, Name, Score):", sortedOutputList);

  });
}


