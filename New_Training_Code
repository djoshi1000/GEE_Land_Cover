// --- final model: map + metrics + lazy mis-classified layer + exports -----------------------
function runFinal(params, trainPx, validPx, stack, bands, ctx) {
  print('Final Random Forest parameters:', params);
  var clf = trainRF(params, trainPx, bands);

  var classified = classifyStack(stack, clf, bands);
  if (APPLY_SMOOTHING) {
    classified = classified.focal_mode(SMOOTHING_RADIUS_PIX, 'circle', 'pixels').toUint8();
  }
  addClassifiedLayer(classified.clip(ctx.processingAOI),
    'RF 16-class ' + targetYear + (APPLY_SMOOTHING ? ' (smoothed)' : ''), true);

  metricsDictionary(clf, trainPx, validPx).evaluate(function (res, err) {
    if (err || !res) {
      print('Metrics failed:', err);
      overallResultLabel.setValue('Overall accuracy: ERROR');
      return;
    }
    reportMetrics(res, 'Validation');
  });

  // Only computed if you switch the layer on
  var misclassified = validPx.classify(clf).map(function (f) {
    return f.set('isMis', ee.Number(f.get('Class')).toInt().neq(ee.Number(f.get('classification')).toInt()));
  }).filter(ee.Filter.eq('isMis', 1));
  addRunLayer(misclassified, {color: 'red'}, 'Misclassified validation pixels (toggle on to compute)', false);

  if (EXPORT_FINAL_MODEL) exportClassifier(clf, params, bands);
  if (EXPORT_CLASSIFIED)  exportClassified(classified, ctx);
}

// --- tuner: whole grid scored in ONE request on a class-balanced subsample -------------------
function tuneAndRunFinal(trainPx, validPx, stack, bands, ctx) {
  var grid = [];
  TUNE_GRID.numberOfTrees.forEach(function (t) {
    TUNE_GRID.minLeafPopulation.forEach(function (l) {
      TUNE_GRID.variablesPerSplit.forEach(function (v) {
        TUNE_GRID.bagFraction.forEach(function (b) {
          grid.push({numberOfTrees: t, minLeafPopulation: l, variablesPerSplit: v, bagFraction: b, seed: randomSeed});
        });
      });
    });
  });
  print('Tuning ' + grid.length + ' parameter combinations on a class-balanced subsample (max ' +
        TUNE_PIXELS_PER_CLASS + ' training pixels per class)...');

  var tuneTrain = capPerClass(trainPx, TUNE_PIXELS_PER_CLASS, randomSeed + 1);
  var scores = grid.map(function (p) {
    var em = validPx.classify(trainRF(p, tuneTrain, bands)).errorMatrix('Class', 'classification', CLASS_ORDER);
    return ee.Dictionary({oa: em.accuracy(), kappa: em.kappa()});
  });

  ee.List(scores).evaluate(function (res, err) {
    if (err || !res) {
      print('Tuning failed:', err, '- reduce TUNE_PIXELS_PER_CLASS or the grid, or raise SAMPLE_TILE_SCALE.');
      return;
    }
    var best = 0;
    res.forEach(function (r, i) {
      print('Combo ' + (i + 1) + ': ' + JSON.stringify(grid[i]) + '   OA ' + fmt(r.oa) + '   Kappa ' + fmt(r.kappa));
      if (r.kappa > res[best].kappa || (r.kappa === res[best].kappa && r.oa > res[best].oa)) best = i;
    });
    print('Best combination: #' + (best + 1), grid[best]);
    runFinal(grid[best], trainPx, validPx, stack, bands, ctx);
  });
}

// --- apply a saved classifier asset (no training) -------------------------------------------
function applySavedModel(assetId, validPx, stack, ctx) {
  var clf   = ee.Classifier.load(assetId);
  var bands = clf.schema();
  print('Applying saved model ' + assetId + '. Its input bands:', bands);

  var classified = classifyStack(stack, clf, bands);
  if (APPLY_SMOOTHING) {
    classified = classified.focal_mode(SMOOTHING_RADIUS_PIX, 'circle', 'pixels').toUint8();
  }
  addClassifiedLayer(classified.clip(ctx.processingAOI), 'RF 16-class ' + targetYear + ' (saved model)', true);

  metricsDictionary(clf, null, validPx).evaluate(function (res, err) {
    if (err || !res) {
      print('Validation of the saved model failed. Do the current settings produce every band the model ' +
            'needs, and are there samples inside the TRAIN counties?', err);
      return;
    }
    reportMetrics(res, 'Saved model on current validation samples');
  });
  if (EXPORT_CLASSIFIED) exportClassified(classified, ctx);
}


// ==================================================================================
//  9. MAIN
// ==================================================================================
function run_ml_model() {
  clearRunLayers();
  var bands = getModelBands();

  // Geometries -------------------------------------------------------------------------------
  var inferFC       = countiesFC(INFER_SELECTED_COUNTIES);
  var trainFC       = countiesFC(TRAIN_SELECTED_COUNTIES);
  var inferAOI      = inferFC.geometry().dissolve(1);
  var trainBuffer   = trainFC.geometry().dissolve(1).buffer(TRAIN_BUFFER_KM * 1000);
  var processingAOI = inferAOI.union(trainBuffer, 1);
  var ctx = {inferAOI: inferAOI, trainBuffer: trainBuffer, processingAOI: processingAOI};

  addRunLayer(inferFC.style({color: '000000', fillColor: '00000000', width: 2}), {}, 'INFER counties', true);
  addRunLayer(trainFC.style({color: '00AAFF', fillColor: '00000000', width: 2}), {}, 'TRAIN counties', false);
  addRunLayer(ee.FeatureCollection(trainBuffer).style({color: '00FF00', fillColor: '00FF0040', width: 2}), {},
              'Training buffer (' + TRAIN_BUFFER_KM + ' km)', false);
  Map.centerObject(inferAOI, 9);

  print('Run settings:', {
    project: project_name, year: targetYear, mode: MOSAIC_MODE_PRIMARY, crs: OUTPUT_CRS,
    cloudMask: CLOUD_MASK, maxSceneCloudPct: MAX_CLOUD_PERCENT, seasonalBands: ADD_SEASONAL_BANDS,
    sampleSource: SAMPLE_SOURCE, trainCounties: TRAIN_SELECTED_COUNTIES, inferCounties: INFER_SELECTED_COUNTIES
  });

  // Imagery ----------------------------------------------------------------------------------
  var ranges = seasonRanges(targetYear);
  addRunLayer(s2Collection(ranges.Summer, processingAOI).select(['B4', 'B3', 'B2']).median()
                .divide(10000).clip(processingAOI), VIS_RGB, 'Sentinel-2 summer RGB ' + targetYear, true);

  var stack = buildStack(MOSAIC_MODE_PRIMARY, processingAOI, targetYear);
  print('Model bands (' + bands.length + '):', bands);

  if (SHOW_MOSAICS_ONLY) {
    addRunLayer(stack.clip(processingAOI), VIS_RGB, 'Mosaic: ' + MOSAIC_MODE_PRIMARY + ' ' + targetYear, true);
    if (EXPORT_ALL_IMAGES) {
      var stackName = runTag() + '_stack';
      Export.image.toDrive({
        image: stack.select(bands).clip(processingAOI), description: stackName, folder: driveFolder(),
        fileNamePrefix: stackName, region: processingAOI, scale: SAMPLE_SCALE, crs: OUTPUT_CRS, maxPixels: 1e13
      });
      print('Export task created: ' + stackName);
    }
    print('Mosaic displayed; Random Forest skipped.');
    return;
  }

  // Samples ----------------------------------------------------------------------------------
  var trainPx, validPx;
  
  if (SAMPLE_SOURCE === 'Pixel asset') {
  
    var px = ee.FeatureCollection(SAMPLE_ASSET_ID)
      .map(function (f) {
        return f.set(
          'Class',
          ee.Number(f.get('Class')).toInt()
        );
      });
  
    trainPx = px.filter(
      ee.Filter.lt('rand', TRAIN_FRACTION)
    );
  
    validPx = px.filter(
      ee.Filter.gte('rand', TRAIN_FRACTION)
    );
  
    print(
      'Using pre-sampled pixels from ' +
      SAMPLE_ASSET_ID +
      ' (image sampling skipped).'
    );
  
  } else {
  
    var samples = gatherSampleGeometries();
  
    if (!samples) {
      print(
        'ERROR: no sample geometries found - nothing to train on.'
      );
      return;
    }
  
    samples = samples
      .filterBounds(trainBuffer)
      .randomColumn('rand', randomSeed);
  
    var trainGeoms = samples.filter(
      ee.Filter.lt('rand', TRAIN_FRACTION)
    );
  
    var validGeoms = samples.filter(
      ee.Filter.gte('rand', TRAIN_FRACTION)
    );
  
    trainPx = samplePixels(
      stack,
      trainGeoms,
      bands,
      false,
      ['Class']
    );
  
    validPx = samplePixels(
      stack,
      validGeoms,
      bands,
      true,
      ['Class']
    );
  
    if (EXPORT_SAMPLE_GEOMS) {
  
      var geomName =
        'RF_samples_geom_' +
        safeAssetName(project_name);
  
      Export.table.toAsset({
        collection: samples.select(['Class', 'rand']),
        description: geomName,
        assetId: ASSET_ROOT + geomName
      });
  
      print(
        'Sample-geometry export task created: ' +
        ASSET_ROOT +
        geomName +
        '  (then choose "Geometry asset" as sample source).'
      );
    }
  
    if (EXPORT_SAMPLED_PIXELS) {
  
      var pxName =
        'RF_samples_px_' +
        runTag();
  
      Export.table.toAsset({
        collection: samplePixels(
          stack,
          samples,
          null,
          true,
          ['Class', 'rand']
        ),
        description: pxName,
        assetId: ASSET_ROOT + pxName
      });
  
      print(
        'Sampled-pixel export task created: ' +
        ASSET_ROOT +
        pxName +
        '  (then choose "Pixel asset" as sample source for fast re-runs / tuning).'
      );
    }
  }
  
  trainPx = capPerClass(
    trainPx,
    MAX_TRAIN_PIXELS_PER_CLASS,
    randomSeed
  );

  // Model ------------------------------------------------------------------------------------
  if (APPLY_MODEL_ASSET) { applySavedModel(APPLY_MODEL_ASSET, validPx, stack, ctx); return; }
  if (TUNE_MODEL) {
    tuneAndRunFinal(trainPx, validPx, stack, bands, ctx);
  } else {
    runFinal({numberOfTrees: numberOfTrees, minLeafPopulation: minLeafPopulation,
              variablesPerSplit: variablesPerSplit, bagFraction: bagFraction, seed: randomSeed},
             trainPx, validPx, stack, bands, ctx);
  }
}


