function maskS2clouds(image) {
  var qa = image.select('QA60');
  var cloudBitMask  = 1 << 10;
  var cirrusBitMask = 1 << 11;
  var mask = qa.bitwiseAnd(cloudBitMask).eq(0)
              .and(qa.bitwiseAnd(cirrusBitMask).eq(0));
  return image.updateMask(mask);
}

function scaleSentinel2(image) {
  var optical = image.select('B.*').divide(10000);
  return image.addBands(optical, null, true);
}

function createDateRanges(year) {
  var r1 = ee.DateRange(ee.Date.fromYMD(year, 1, 1),  ee.Date.fromYMD(year, 4, 30));
  var r2 = ee.DateRange(ee.Date.fromYMD(year, 5, 1),  ee.Date.fromYMD(year, 8, 31));
  var r3 = ee.DateRange(ee.Date.fromYMD(year, 9, 1),  ee.Date.fromYMD(year,12,31));
  return [r1, r2, r3];
}

function safeProjection(image) {
  var tryBands = ee.List(['B2','B3','B4','B8','B11','B12']);

  // Build a list of available bands using iterate (server-safe)
  var available = ee.List(
    tryBands.iterate(function(b, acc) {
      b = ee.String(b);
      return ee.Algorithms.If(
        image.bandNames().contains(b),
        ee.List(acc).add(b),
        acc
      );
    }, ee.List([]))
  );

// Choose the first available band or fallback to the first band in the image
var chosenBand = ee.Algorithms.If(
  available.size().gt(0),
  available.get(0),
  image.bandNames().get(0)
);

// Safe one-band selection → valid projection
return image.select(ee.String(chosenBand)).projection();
}

function resampleCollectionTo10m(col) {
  return ee.ImageCollection(col).map(function(img) {
    var proj10 = safeProjection(img);
    return img
      .resample('bilinear')
      .reproject({crs: proj10, scale: 10});
  });
}

