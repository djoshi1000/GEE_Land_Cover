    // Confusion matrix from the SAME validated set
    var em = validated.errorMatrix('Class', 'classification', CLASS_ORDER);
    printConfusionExpanded(em, 'Validation');
    print('Per-class accuracy table:', perClassAccuracyTable(em));
    
    // Get OA & kappa (server-side)
    var oa = em.accuracy();
    var kappa = em.kappa();
    
    // Print combination & metrics
    print('Combination', idx+1, p, 'OA:', oa, 'Kappa:', kappa);
    
     // Store for later (client side storage)
    kappaList.push(kappa);
    paramList.push(p);
    indexList.push(idx);
    
  });
  
  // Now we need to evaluate all kappa values and find the best one
// Now we need to evaluate all kappa values and find the best one
ee.List(kappaList).evaluate(function(kappaValues) {

  // --- SAFETY GUARD ---
  if (kappaValues === undefined || kappaValues === null) {
    print('TUNE ERROR: kappaValues is undefined/null.');
    print('This usually means the server evaluation failed (timeout/memory).');
    print('Check the Console for the RED error message above, then reduce grid size or limit pixels.');
