function runFinalRF(bestParams, trainPx, split, image_stack, processingGeometry) {

  print('------------------------------------------');
  print('USING BEST RF PARAMS:', bestParams);
  print('------------------------------------------');

  var bestClassifier = ee.Classifier.smileRandomForest(bestParams).train({
    features: trainPx,
    classProperty: 'Class',
    inputProperties: FINAL_MODEL_BANDS
  });

  // Export trained model asset only if UI checkbox is enabled
  if (EXPORT_FINAL_MODEL) {
    if (!GEE_PROJECT_ID || GEE_PROJECT_ID === 'YOUR_GEE_PROJECT_ID') {
      print('WARNING: Model export is enabled, but GEE_PROJECT_ID is not set correctly.');
      print('Please update GEE_PROJECT_ID near the top of the script.');
    } else {
      exportSavedClassifier(bestClassifier, bestParams, FINAL_MODEL_BANDS);
    }
  }

  // Final classified map
  var final_classified = classifyAndAddLayer(
    image_stack,
    bestClassifier,
    'RF 16-Classified (FINAL)',
    processingGeometry,
    true
  );

  if (APPLY_SMOOTHING) {
    final_classified = final_classified
      .focal_mode(SMOOTHING_RADIUS_PIX, 'circle', 'pixels')
      .toUint8();

    Map.addLayer(final_classified, {
      min: 1, max: CLASS_COUNT, palette: classPalette, opacity: 1.0
    }, 'RF 16-Classified (FINAL + SMOOTHED)', true);
  }

  var validPts = samplePixels(image_stack, split.valid, SAMPLE_SCALE, true, 16);
  print("Valid pixels USED (geom):", validPts.size());

  var validatedPts = validPts.classify(bestClassifier);
  printValidationMetrics(validatedPts, "Validation (MODEL)");

  var IncorrectClassified = validatedPts.map(function(f) {
    var truth = ee.Number(f.get('Class')).toInt();
    var pred  = ee.Number(f.get('classification')).toInt();
    return f.set({
      truth_label: truth,
      pred_label: pred,
      isMis: truth.neq(pred).int()
    });
  }).filter(ee.Filter.eq('isMis', 1));

  print("Incorrect validation pixels:", IncorrectClassified.size());
  Map.addLayer(IncorrectClassified, {color: 'red'}, 'Incorrectly Classed Points', false);

  var importance = ee.Dictionary(bestClassifier.explain().get('importance'));
  sortImportanceDictionary(importance);

  var REPORT_MAP_METRICS = false;

  if (REPORT_MAP_METRICS || APPLY_SMOOTHING) {
    var mapPts = final_classified.rename('pred').sampleRegions({
      collection: validPts,
      properties: ['Class'],
      scale: 10,
      tileScale: 16,
      geometries: true
    }).filter(ee.Filter.notNull(['pred']));

    var emMap = mapPts.errorMatrix('Class', 'pred', CLASS_ORDER);
    print("Validation (MAP/product) matrix:", emMap);
    print("Validation (MAP/product) OA:", emMap.accuracy());
    print("Validation (MAP/product) Kappa:", emMap.kappa());
  }

  if (EXPORT_CLASSIFIED) {
    var export_name = project_name + "_" + targetYear;

    Export.image.toDrive({
      image: final_classified,
      description: export_name,
      folder: "GEE_Random_Forest_" + project_name,
      fileNamePrefix: export_name,
      region: processingGeometry,
      scale: SAMPLE_SCALE,
      maxPixels: 1e13
    });
  }
}


// =======================================================================
// TUNE RF -> pick BEST -> auto-run FINAL map + metrics
// =======================================================================
function tuneRandomForestAndRunFinal(grid, trainPx, validPx, split, image_stack, processingGeometry) {

  // Client-side param storage (plain JS objects)
  var paramList = [];

  // Server-side metric lists (we keep as ee.Numbers in JS arrays then evaluate once)
  var oaList = [];
  var kappaList = [];

  grid.forEach(function(p, idx) {
    paramList.push(p);

    // var clf = ee.Classifier.smileRandomForest(p).train(trainPx, 'Class');
    var clf = ee.Classifier.smileRandomForest(p).train({
        features: trainPx,
        classProperty: 'Class',
        inputProperties: FINAL_MODEL_BANDS });
        
    var validated = validPx.classify(clf);

    var em = validated.errorMatrix('Class', 'classification', CLASS_ORDER);
    var oa = em.accuracy();
    var kappa = em.kappa();

    // print each combo (server-side numbers print fine)
    print('Combo', idx + 1, p, 'OA:', oa, 'Kappa:', kappa);

    oaList.push(oa);
    kappaList.push(kappa);
  });

  // Evaluate both lists once, choose best on client, then run FINAL
  ee.Dictionary({
    oa: ee.List(oaList),
    kappa: ee.List(kappaList)
  }).evaluate(function(res, err) {

    if (err || !res || !res.kappa || !res.oa) {
      print('TUNE ERROR:', err);
      print('Try reducing grid size or increasing tileScale in samplePixels().');
      return;
    }

    var oaArr = res.oa;       // JS number array
    var kArr  = res.kappa;    // JS number array

    var bestIndex = 0;
    var bestK = -999;
    var bestOA = -999;

    // Max Kappa; tie-break with OA
    for (var i = 0; i < kArr.length; i++) {
      var k = kArr[i];
      var oa = oaArr[i];

      if (k > bestK || (k === bestK && oa > bestOA)) {
        bestK = k;
        bestOA = oa;
        bestIndex = i;
      }
    }

    var bestParams = paramList[bestIndex];

    print('==========================================');
    print('BEST INDEX (1-based):', bestIndex + 1);
    print('BEST KAPPA:', bestK);
    print('BEST OA:', bestOA);
    print('BEST PARAMS:', bestParams);
    print('==========================================');

    // Auto-run final map + metrics with best params
    runFinalRF(bestParams, trainPx, split, image_stack, processingGeometry);
  });
}


