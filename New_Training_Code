// Multi-band, fully masked zero image with the given band names (safe fallback for empty collections)
function emptyImage(bandNames) {
  return ee.Image.constant(bandNames.map(function () { return 0; })).rename(bandNames).selfMask();
}

var SEASONS_FOR_MODE = {
  All: ['Spring', 'Summer', 'Fall'], Spring_Summer: ['Spring', 'Summer'],
  Spring: ['Spring'], Summer: ['Summer'], Fall: ['Fall']
};
function seasonRanges(year) {
  var d = function (y, m) { return ee.Date.fromYMD(y, m, 1); };
  return {
    Spring: ee.DateRange(d(year, 1), d(year, 5)),      // Jan 1 - Apr 30
    Summer: ee.DateRange(d(year, 5), d(year, 9)),      // May 1 - Aug 31
    Fall:   ee.DateRange(d(year, 9), d(year + 1, 1))   // Sep 1 - Dec 31
  };
}

// Model bands = checked bands (fixed order) + seasonal bands when the mode has more than one season
function getModelBands() {
  var bands = ALL_BAND_KEYS.filter(function (b) { return bandChecks[b].getValue(); });
