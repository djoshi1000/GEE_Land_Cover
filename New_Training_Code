// ==================================================================================
//  6. IMAGE PIPELINE
// ==================================================================================
var S2      = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED');
var CS_PLUS = ee.ImageCollection('GOOGLE/CLOUD_SCORE_PLUS/V1/S2_HARMONIZED');
var S1      = ee.ImageCollection('COPERNICUS/S1_GRD');

// --- cloud masking -----------------------------------------------------------------------
function maskQA60(img) {
  var qa = img.select('QA60');
  return img.updateMask(qa.bitwiseAnd(1 << 10).eq(0).and(qa.bitwiseAnd(1 << 11).eq(0)));
}
function maskCloudScorePlus(img) {
  return img.updateMask(img.select('cs_cdf').gte(CS_PLUS_THRESHOLD));
}
function s2Collection(range, aoi) {
  var col = S2.filterDate(range).filterBounds(aoi)
    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', MAX_CLOUD_PERCENT));
  return (CLOUD_MASK === 'CSPLUS')
    ? col.linkCollection(CS_PLUS, ['cs_cdf']).map(maskCloudScorePlus)
    : col.map(maskQA60);
}

// --- per-scene bands (cheap, purely spectral; everything expensive happens on the composite) --
function perImageBands(img) {
  var s  = img.select(S2_BANDS).divide(10000).toFloat();
  var b2 = s.select('B2'), b3 = s.select('B3'), b4 = s.select('B4'),
      b8 = s.select('B8'), b11 = s.select('B11'), b12 = s.select('B12');

  var ndvi  = s.normalizedDifference(['B8', 'B4']).rename('NDVI');      // (NIR-Red)/(NIR+Red)
  var ndwi  = s.normalizedDifference(['B3', 'B8']).rename('NDWI');      // internal water test
  var mndwi = s.normalizedDifference(['B3', 'B11']).rename('B_MNDWI');
  var ndmi  = s.normalizedDifference(['B8A', 'B11']).rename('B_NDMI');
  var ndre  = s.normalizedDifference(['B8A', 'B5']).rename('B_NDRE');
  var lswi  = s.normalizedDifference(['B8', 'B11']).rename('B_LSWI');
  var nbr   = s.normalizedDifference(['B8', 'B12']).rename('B_NBR');
  var evi2  = s.expression('2.5 * (NIR - RED) / (NIR + 2.4 * RED + 1.0)', {NIR: b8, RED: b4}).rename('B_EVI2');

  var swirCombo = s.expression('((NIR + SWIR1) / (SWIR2 + eps) + SWIR1 / (SWIR2 + eps)) / 2',
    {NIR: b8, SWIR1: b11, SWIR2: b12, eps: EPS}).rename('B_SWIR_COMBO');

  var baei = s.expression('(RED + 0.3) / (GREEN + SWIR1 + eps)', {RED: b4, GREEN: b3, SWIR1: b11, eps: EPS})
    .where(ndwi.gt(0), 0).min(2).rename('B_BAEI');

  var tcw = s.expression('0.1509*B2 + 0.1973*B3 + 0.3283*B4 + 0.3407*B8 - 0.7117*B11 - 0.4559*B12',
    {B2: b2, B3: b3, B4: b4, B8: b8, B11: b11, B12: b12}).rename('B_TCW');

  var dryness = s.expression('((SWIR1 + RED) - (NIR + BLUE)) / ((SWIR1 + RED) + (NIR + BLUE) + eps)',
    {SWIR1: b11, RED: b4, NIR: b8, BLUE: b2, eps: EPS});
  var comboVeg = evi2.multiply(lswi.add(nbr)).divide(2).rename('B_COMBO_VEG');
  var pasture  = comboVeg.subtract(dryness).where(ndwi.gt(0.1), -5).rename('B_PASTURE_PROB');
  // NOTE: no unmask() here - cloud-masked pixels must stay masked so the median ignores them.

  return s.addBands([ndvi, ndwi, mndwi, ndmi, ndre, lswi, nbr, evi2, swirCombo, baei, tcw, comboVeg, pasture]);
}

// --- texture on the composite (once per season instead of once per scene) ------------------
function glcmVariance(img, name) {
  var gray = img.unmask(0).clamp(0, 255).round().toUint8().rename(name);
  return gray.glcmTexture({size: GLCM_SIZE}).select(name + '_var').rename(name + '_GLCM_var');
}

// --- Sentinel-1 statistics for a season (once per season instead of once per S2 scene) -------
function s1Features(range, aoi) {
  var col = S1.filterDate(range).filterBounds(aoi)
    .filter(ee.Filter.eq('instrumentMode', 'IW'))
    .filter(ee.Filter.eq('resolution_meters', 10))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VV'))
    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))
    .select(['VV', 'VH']);
  if (S1_ORBIT_PASS) col = col.filter(ee.Filter.eq('orbitProperties_pass', S1_ORBIT_PASS));

  var features = ee.Image(ee.Algorithms.If(
    col.size().gt(0),
    (function () {
      var meanDb = col.mean();
      var vv = ee.Image(10).pow(meanDb.select('VV').divide(10));   // dB -> linear power (10^(dB/10))
      var vh = ee.Image(10).pow(meanDb.select('VH').divide(10));
      var rvi = vh.multiply(4).divide(vv.add(vh).add(EPS)).rename('B_RVI');   // 4*VH/(VV+VH), ~0..2
      var sd  = col.reduce(ee.Reducer.stdDev()).rename(['B_VV_StdDev', 'B_VH_StdDev']);
      return rvi.addBands(sd);
    })(),
    emptyImage(S1_BANDS)
  ));
  return features.select(S1_BANDS).unmask(0).toFloat();
}

// --- static terrain features ---------------------------------------------------------------
// USGS 3DEP slope + HydroSHEDS-based wetness proxy.
//
// IMPORTANT:
// ImageCollection.mosaic() loses the useful native DEM projection unless
// we explicitly restore it. Terrain calculations must be performed at the
// native DEM resolution, NOT at the default 1-degree mosaic projection.
function terrainFeatures(aoi) {

  // Buffer gives slope/focal operations plenty of pixels around AOI edges.
  var terrainAOI = aoi.buffer(2000);

  // -------------------------------------------------------------------------
  // USGS 3DEP 10 m DEM
  // -------------------------------------------------------------------------
  var demCol = ee.ImageCollection('USGS/3DEP/10m_collection')
    .filterBounds(terrainAOI)
    .select('elevation');

  // Grab the native projection BEFORE mosaicking.
  var demProjection = ee.Image(demCol.first())
    .select('elevation')
    .projection();

  // Mosaic first, then explicitly restore the native DEM projection.
  //
  // DO NOT clip here. Slope needs neighboring DEM pixels.
  var dem = demCol
    .mosaic()
    .setDefaultProjection(demProjection);

  // -------------------------------------------------------------------------
  // SLOPE
  // -------------------------------------------------------------------------
  var slopeDeg = ee.Terrain.slope(dem);

  var slopeRad = slopeDeg
    .multiply(Math.PI / 180.0)
    .focalMean({
      radius: 30,
      kernelType: 'circle',
      units: 'meters'
    })
    .rename('B_SLOPE')
    .toFloat();

  // -------------------------------------------------------------------------
  // HydroSHEDS flow accumulation
  // -------------------------------------------------------------------------
  var flowAcc = ee.Image('WWF/HydroSHEDS/15ACC')
    .select('b1')
    .toFloat()
    .resample('bilinear');

  // -------------------------------------------------------------------------
  // Wetness proxy
  //
  // Keep current formulation for consistency with your previous model.
  // EPS protects flat terrain from divide-by-zero.
  // -------------------------------------------------------------------------
  var twi = flowAcc
    .divide(slopeRad.max(0.001))
    .add(1)
    .log()
    .focalMean({
      radius: 60,
      kernelType: 'circle',
      units: 'meters'
    })
    .rename('B_TWI')
    .toFloat();

  // Clip ONLY AFTER slope/TWI have been calculated.
  return slopeRad
    .addBands(twi)
    .clip(aoi);
}

// --- one seasonal composite with all composite-level features -------------------------------
function seasonFeatures(range, aoi) {
  var col = s2Collection(range, aoi).map(perImageBands);
  var med = ee.Image(ee.Algorithms.If(col.size().gt(0), col.median(), emptyImage(PER_IMAGE_BANDS)))
    .select(PER_IMAGE_BANDS);

  var ndmi     = med.select('B_NDMI');
  var water    = med.select('NDWI').gt(0);
  var ndmiTex  = glcmVariance(ndmi.add(1).multiply(127.5), 'B_NDMI')    // NDMI -1..1 -> 0..255 grey levels
    .divide(NDMI_GLCM_VAR_SCALE).clamp(0, 1);
  var moisture = ndmi.add(ndmiTex).divide(2).where(water, -1).rename('B_MOISTURE');
  var b8Tex    = glcmVariance(med.select('B8').multiply(255), 'B8');    // -> 'B8_GLCM_var'

  return med.addBands([moisture, b8Tex, s1Features(range, aoi)]);
}

// --- full feature stack for a season mode ---------------------------------------------------
function buildStack(mode, aoi, year) {
  var ranges  = seasonRanges(year);
  var seasons = SEASONS_FOR_MODE[mode];

  var comps = seasons.map(function (s) {
    return seasonFeatures(ranges[s], aoi);
  });

  var base = (comps.length === 1)
    ? comps[0]
    : ee.ImageCollection(comps).median();

  // Build terrain specifically for this processing AOI.
  var stack = base.addBands(terrainFeatures(aoi));

  if (ADD_SEASONAL_BANDS && comps.length > 1) {
    seasons.forEach(function (s, i) {
      var names = SEASONAL_SOURCES.map(function (b) {
        return b + '_' + s;
      });

      stack = stack.addBands(
        comps[i].select(SEASONAL_SOURCES, names)
      );
    });
  }

  return stack.toFloat();
}


// ==================================================================================
//  7. SAMPLES
// ==================================================================================
// Any import (FeatureCollection, Feature or Geometry) -> FeatureCollection with 'Class' set.
// Multi-geometries are exploded so the train/validation split works per point/polygon.
function toClassFC(x, classId) {
  var fc = (x instanceof ee.Geometry)
    ? ee.FeatureCollection(x.geometries().map(function (g) { return ee.Feature(ee.Geometry(g)); }))
    : ee.FeatureCollection(x);
  return fc.map(function (f) { return f.set('Class', classId); });
}

function gatherSampleGeometries() {
  if (SAMPLE_SOURCE === 'Geometry asset') {
    return ee.FeatureCollection(SAMPLE_ASSET_ID)
      .map(function (f) { return f.set('Class', ee.Number(f.get('Class')).toInt()); });
  }
  var parts = [], missing = [];
  CLASS_IMPORT_NAMES.forEach(function (name, i) {
    var imp = getClassImport(i);
    if (imp === null || imp === undefined) { missing.push(name); return; }
    parts.push(toClassFC(imp, i + 1));
  });
  if (missing.length) {
    print('WARNING: no import found for ' + missing.join(', ') + ' - these classes will have no samples.');
  }
  return parts.length ? ee.FeatureCollection(parts).flatten() : null;
}

function samplePixels(stack, fc, bands, keepGeometries, props) {
  var img = bands ? stack.select(bands) : stack;
  return img.sampleRegions({
    collection: fc, properties: props, scale: SAMPLE_SCALE, projection: OUTPUT_CRS,
    tileScale: SAMPLE_TILE_SCALE, geometries: keepGeometries
  });
}

// Random, seeded cap of pixels per class (rare classes keep everything)
function capPerClass(fc, cap, seed) {
  if (!cap) return fc;
  var withRand = fc.randomColumn('capRand', seed);
  var parts = [];
  for (var c = 1; c <= CLASS_COUNT; c++) {
    parts.push(withRand.filter(ee.Filter.eq('Class', c)).limit(cap, 'capRand'));
  }
  return ee.FeatureCollection(parts).flatten();
}


// ==================================================================================
//  8. RANDOM FOREST: train, evaluate (one request), tune, classify, export
// ==================================================================================
function trainRF(params, trainPx, bands) {
  return ee.Classifier.smileRandomForest(params)
    .train({features: trainPx, classProperty: 'Class', inputProperties: bands});
}

function classifyStack(stack, clf, bands) {
  return stack.select(bands).classify(clf).toUint8().rename('classification');
}

function addClassifiedLayer(img, label, shown) {
  var display = DISPLAY_AT_10M ? img.reproject({crs: OUTPUT_CRS, scale: SAMPLE_SCALE}) : img;
  addRunLayer(display, {min: 1, max: CLASS_COUNT, palette: classPalette}, label, shown);
}

// Everything we want to know about a model, assembled server-side and fetched in ONE request
function metricsDictionary(clf, trainPx, validPx) {
  var em = validPx.classify(clf).errorMatrix('Class', 'classification', CLASS_ORDER);
  var explained = ee.Dictionary(clf.explain());
  return ee.Dictionary({
    nTrain:        trainPx ? trainPx.size() : -1,
    nValid:        validPx.size(),
    trainPerClass: trainPx ? trainPx.aggregate_histogram('Class') : ee.Dictionary({}),
    validPerClass: validPx.aggregate_histogram('Class'),
    matrix:        em.array(),
    oa:            em.accuracy(),
    kappa:         em.kappa(),
    producers:     em.producersAccuracy().project([0]).toList(),
    consumers:     em.consumersAccuracy().project([1]).toList(),
    oob:           explained.get('outOfBagErrorEstimate', -1),
    importance:    explained.get('importance', ee.Dictionary({}))
  });
}

function reportMetrics(res, label) {
  var pad = function (v, n) { v = String(v); while (v.length < n) v = ' ' + v; return v; };

  print(label + ': ' + res.nValid + ' validation pixels' +
        (res.nTrain >= 0 ? ', ' + res.nTrain + ' training pixels' : ''));
  print(label + ': Overall accuracy ' + fmt(res.oa) + '  |  Kappa ' + fmt(res.kappa) +
        (res.oob >= 0 ? '  |  RF out-of-bag error ' + fmt(res.oob) : ''));

  var header = pad('ref\\pred', 9) + CLASS_ORDER_JS.map(function (c) { return pad(c, 5); }).join('');
  var rows = res.matrix.map(function (row, i) {
    return pad(i + 1, 9) + row.map(function (v) { return pad(v, 5); }).join('');
  });
  print(label + ': confusion matrix (rows = reference, columns = predicted)', [header].concat(rows));

  var perClass = classLabels.map(function (lbl, i) {
    var c = String(i + 1);
    return lbl + '  |  PA ' + fmt(res.producers[i]) + '  |  UA ' + fmt(res.consumers[i]) +
           '  |  train n=' + (res.trainPerClass[c] || 0) + '  |  valid n=' + (res.validPerClass[c] || 0);
  });
  print(label + ": per-class accuracy (PA = producer's, UA = user's)", perClass);

  var imp = Object.keys(res.importance)
    .map(function (k) { return [k, res.importance[k]]; })
    .sort(function (a, b) { return b[1] - a[1]; });
  print(label + ': feature importance (ranked)',
        imp.map(function (e, i) { return (i + 1) + '. ' + e[0] + ': ' + fmt(e[1], 4); }));

  overallResultLabel.setValue('Overall accuracy: ' + fmt(res.oa));
  overallResultLabel.style().set('color', 'blue');
  kappaResultLabel.setValue('Kappa: ' + fmt(res.kappa));
  kappaResultLabel.style().set('color', 'blue');
}

function exportClassified(img, ctx) {
  var region = EXPORT_INFER_ONLY ? ctx.inferAOI : ctx.processingAOI;
  var name   = runTag() + '_RF16' + (APPLY_SMOOTHING ? '_smoothed' : '');
