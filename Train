function printValidationMetrics(validated, label) {
  
  // 1. Calculate the server-side Error Matrix (ee.ConfusionMatrix)
  var em = validated.errorMatrix('Class', 'classification', CLASS_ORDER);

  // Print the server-side objects for the GEE console
  print(label + " matrix:", em);
  print(label + " OA:", em.accuracy());
  print(label + " kappa:", em.kappa());

  // 2. Prepare the final, formatted strings (server-side)
  // We use .format() to ensure a nice string result before evaluation.
  var overallString = ee.Number(em.accuracy()).format('%.3f');
  var kappaString = ee.Number(em.kappa()).format('%.3f');
  
  // 3. Create a server-side dictionary of the final strings to evaluate
  var metricsToEvaluate = ee.Dictionary({
    overall: overallString,
    kappa: kappaString
  });
  
  // 4. Run the evaluation and handle the client-side update
  metricsToEvaluate.evaluate(function(result, error) {
    if (error) {
      // Handle any errors from the server computation
      overallResultLabel.setValue('Model Metric: ERROR');
      kapaResultLabel.setValue('Kappa Statistics: ERROR');
      print('Evaluation Error:', error);
      return;
    }
    
    // Success: 'result' is a client-side JavaScript object/dictionary.
    // Use .setValue() on the pre-existing UI Labels.
    overallResultLabel.setValue('Model Metric: ' + result.overall);
    kapaResultLabel.setValue('Kappa Statistics: ' + result.kappa);
    
    overallResultLabel.style().set('color', 'blue');
    kapaResultLabel.style().set('color', 'blue');
  });
  
  return em; // Return the server-side ConfusionMatrix object
}


