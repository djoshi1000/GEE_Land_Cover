function classifyAndAddLayer(image_stack, classifier, label, clipGeom, shown) {
  clipGeom = clipGeom || processingGeometry;
  shown = (shown === undefined) ? true : shown;

  // mask of real data (all bands)
  var validDataMask = image_stack.mask().reduce(ee.Reducer.min());

  // classify (do NOT force reproject on the returned image)
  var classified = image_stack.unmask(0).classify(classifier);
  var cleaned = classified.updateMask(validDataMask).clip(clipGeom).toUint8();

  // display-only reprojection (safe to do only for visualization)
  var proj10 = image_stack.select('B2').projection();
  var displayImg = cleaned.reproject({crs: proj10, scale: 10});
  var proj10 = image_stack.select('B2').projection();
  print('B2 projection:', proj10);
  print('B2 nominal scale (m):', proj10.nominalScale());

  
  // display scale (NOT the same as native pixel size)
  // print('Map display scale (m per screen pixel):', Map.getScale());

  Map.addLayer(displayImg, {
    min: 1,
    max: CLASS_COUNT,
    palette: classPalette,
    opacity: 1.0
  }, label, shown);

  return cleaned; // <-- use THIS for export + sampling + mispoints
}


