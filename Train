function createS2Mosaic(dateRange, aoi, cloudPct, label) {
  var col = ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')
  .filterDate(dateRange)
  .filterBounds(aoi)
  .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', cloudPct))
  .map(maskS2clouds)
  .map(addAllDerivedBands);

  col = resampleCollectionTo10m(col);

  // SAFETY: If empty → return a 0-value placeholder image
  col = ee.ImageCollection(ee.Algorithms.If(
    col.size().gt(0),
    col,
    ee.Image(0).rename(processing_bands).selfMask()
  ));

  var mosaic = col.median().clip(aoi);
  return mosaic;
}

// Consolidates a list of images into one image stack (averaged)
function consolidateImages(list) {
  list = ee.List(list);
  var count = list.size();

  var stacked = ee.Image(ee.Algorithms.If(
    count.eq(0),
    ee.Image(0).select().rename(processing_bands).selfMask(),
    ee.ImageCollection(list).reduce(ee.Reducer.mean())
  ));

  // Rename bands back to original processing bands
  // This prevents "_mean" suffix issues
  var consol_image =  stacked.select(stacked.bandNames(), processing_bands);
  print(consol_image);
  
  return consol_image;
}


// Build seasonal image stack for a given mode
function ImageryCompilation(mode, aoi) {
  var ranges = createDateRanges(targetYear); // Your seasonal date ranges
  var mosaic;

  switch(mode) {
    case 'Spring':
      mosaic = createS2Mosaic(ranges[0], aoi, MAX_CLOUD_PERCENT, 'Spring');
      break;
    case 'Summer':
      mosaic = createS2Mosaic(ranges[1], aoi, MAX_CLOUD_PERCENT, 'Summer');
      break;
    case 'Fall':
      mosaic = createS2Mosaic(ranges[2], aoi, MAX_CLOUD_PERCENT, 'Fall');
      break;
    case 'Spring_Summer':
      var spring = createS2Mosaic(ranges[0], aoi, MAX_CLOUD_PERCENT, 'Spring');
      var summer = createS2Mosaic(ranges[1], aoi, MAX_CLOUD_PERCENT, 'Summer');
      mosaic = ee.ImageCollection([spring, summer]).median();
      //mosaic = spring.add(summer).divide(2);
      break;
    case 'All':
      var springAll = createS2Mosaic(ranges[0], aoi, MAX_CLOUD_PERCENT, 'Spring');
      var summerAll = createS2Mosaic(ranges[1], aoi, MAX_CLOUD_PERCENT, 'Summer');
      var fallAll = createS2Mosaic(ranges[2], aoi, MAX_CLOUD_PERCENT, 'Fall');
      mosaic = ee.ImageCollection([springAll, summerAll, fallAll]).median();
      //mosaic = springAll.add(summerAll).add(fallAll).divide(3);
      break;
    default:
      print('Unknown mode:', mode);
      return null;
  }
  
  var scaled_mosaic = mosaic.toDouble();
  print('Final Spectral Stack:', scaled_mosaic);
  return scaled_mosaic;
}



  
