function exportSavedClassifier(bestClassifier, bestParams, modelBands) {
  var modelAssetId = buildModelAssetId();
  var exportDesc = 'RF_MODEL_' +
    safeAssetName(project_name) + '_' +
    String(targetYear) + '_' +
    safeAssetName(MOSAIC_MODE_PRIMARY) + '_' +
    MODEL_VERSION;

  // 1) Export the trained classifier asset
  Export.classifier.toAsset({
    classifier: bestClassifier,
    description: exportDesc,
    assetId: modelAssetId
  });

  print('Classifier export task created.');
  print('Saved model assetId:', modelAssetId);

  // 2) Optional metadata export (very useful for reproducibility)
  if (EXPORT_MODEL_METADATA) {
    var metaFc = ee.FeatureCollection([
      ee.Feature(null, {
        model_asset_id: modelAssetId,
        project_name: project_name,
        target_year: targetYear,
        mosaic_mode: MOSAIC_MODE_PRIMARY,
        model_version: MODEL_VERSION,
        band_list_json: JSON.stringify(modelBands),
        rf_params_json: JSON.stringify(bestParams),
        sample_scale: SAMPLE_SCALE,
        cloud_percent: MAX_CLOUD_PERCENT,
        smoothing_applied: APPLY_SMOOTHING,
        smoothing_radius_pix: SMOOTHING_RADIUS_PIX
      })
    ]);

    Export.table.toDrive({
      collection: metaFc,
      description: exportDesc + '_META',
      folder: 'GEE_Random_Forest_' + safeAssetName(project_name),
      fileNamePrefix: exportDesc + '_META',
      fileFormat: 'CSV'
    });

    print('Model metadata export task created.');
  }
}


